# The clutch command (`pulley install polymorphia.clutch`; `pulley run clutch` in a project that depends
# on it): clutch COMMAND ...
#   up [clutch.cw] | serve [clutch.cw] [port] | check [clutch.cw]
#   status|start|stop|restart|logs [name] [port] | shutdown [port]
import clutch
import os
return clutch.main(os.args())
